+/* Lexicographic compare of two BER-encoded OIDs. <0, 0, >0 like memcmp.
+   Shorter OID sorts before a longer one that shares its prefix. */
+static int32_t oidCompare(const uint8_t *a, int32_t alen,
+                          const uint8_t *b, int32_t blen)
+{
+	int32_t n = (alen < blen) ? alen : blen;
+	int32_t r = memcmp(a, b, (size_t)n);
+
+	if (r != 0) return r;
+	return alen - blen;
+}
+
