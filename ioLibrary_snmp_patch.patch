+#define MAX_BULK_VARS 8
+
+static int32_t writeBulkVarBind(int32_t id, uint8_t *fallback_oid, uint8_t fallback_len)
+{
+	int32_t inner = 0;
+	int32_t seq_start = response_msg.index;
+
+	if ((response_msg.index + 4 + MAX_OID + MAX_STRING) >= MAX_SNMPMSG_LEN) return -1;
+
+	response_msg.buffer[response_msg.index++] = SNMPDTYPE_SEQUENCE;
+	int32_t len_pos = response_msg.index++;
+
+	if (id >= 0 && id < maxData)
+	{
+		uint8_t oid_len = snmpData[id].oidlen;
+		response_msg.buffer[response_msg.index++] = SNMPDTYPE_OBJ_ID;
+		response_msg.buffer[response_msg.index++] = oid_len;
+		memcpy(&response_msg.buffer[response_msg.index], snmpData[id].oid, oid_len);
+		response_msg.index += oid_len;
+		inner += 2 + oid_len;
+
+		uint8_t dtype;
+		int32_t vlen;
+		getEntry(id, &dtype, &response_msg.buffer[response_msg.index + 2], &vlen);
+		response_msg.buffer[response_msg.index++] = dtype;
+		response_msg.buffer[response_msg.index++] = (uint8_t)vlen;
+		response_msg.index += vlen;
+		inner += 2 + vlen;
+	}
+	else
+	{
+		response_msg.buffer[response_msg.index++] = SNMPDTYPE_OBJ_ID;
+		response_msg.buffer[response_msg.index++] = fallback_len;
+		memcpy(&response_msg.buffer[response_msg.index], fallback_oid, fallback_len);
+		response_msg.index += fallback_len;
+		inner += 2 + fallback_len;
+
+		response_msg.buffer[response_msg.index++] = SNMPDTYPE_END_OF_MIB_VIEW;
+		response_msg.buffer[response_msg.index++] = 0x00;
+		inner += 2;
+	}
+
+	response_msg.buffer[len_pos] = (uint8_t)inner;
+	return inner + 2;
+}
