+// Standard SNMPv2c notification OID prefix: 1.3.6.1.6.3.1.1.5.x
+static const uint8_t snmpv2_std_trap_prefix[] = {0x2b, 0x06, 0x01, 0x06, 0x03, 0x01, 0x01, 0x05};
+// sysUpTime.0  : 1.3.6.1.2.1.1.3.0
+static const uint8_t oid_sysUpTime[]  = {0x2b, 0x06, 0x01, 0x02, 0x01, 0x01, 0x03, 0x00};
+// snmpTrapOID.0: 1.3.6.1.6.3.1.1.4.1.0
+static const uint8_t oid_snmpTrapOID[] = {0x2b, 0x06, 0x01, 0x06, 0x03, 0x01, 0x01, 0x04, 0x01, 0x00};
+
+int32_t snmp_sendTrapV2c(uint8_t *managerIP, uint8_t *agentIP, int8_t *community,
+                          dataEntryType enterprise_oid, uint32_t genericTrap,
+                          uint32_t specificTrap, uint32_t va_count, ...)
+{
+	uint32_t i;
+	int32_t  packet_index = 0;
+	int32_t  pb_outer, pb_pdu, pb_varbinds;
+	va_list  ap;
+	uint32_t length_buff = 0;
+	uint32_t uptime = 0;
+	uint8_t  uptime_len = 4;
+	uint8_t  trap_oid[MAX_OID];
+	uint8_t  trap_oid_len;
+
+	// Derive the SNMPv2 notification OID
+	if (genericTrap <= 5)
+	{
+		memcpy(trap_oid, snmpv2_std_trap_prefix, sizeof(snmpv2_std_trap_prefix));
+		trap_oid[sizeof(snmpv2_std_trap_prefix)] = (uint8_t)(genericTrap + 1);
+		trap_oid_len = (uint8_t)(sizeof(snmpv2_std_trap_prefix) + 1);
+	}
+	else
+	{
+		trap_oid_len = enterprise_oid.oidlen;
+		memcpy(trap_oid, enterprise_oid.oid, trap_oid_len);
+	}
+
+	// Outer SEQUENCE
+	packet_trap[packet_index++] = 0x30;
+	packet_trap[packet_index] = 0xff;
+	pb_outer = packet_index++;
+
+	// Version = 1 (SNMPv2c)
+	packet_trap[packet_index++] = 0x02;
+	packet_trap[packet_index++] = 0x01;
+	packet_trap[packet_index++] = SNMP_V2C;
+
+	// Community
+	packet_trap[packet_index++] = 0x04;
+	packet_trap[packet_index++] = (uint8_t)strlen((char const*)community);
+	memcpy(&packet_trap[packet_index], community, strlen((char const*)community));
+	packet_index += (uint8_t)strlen((char const*)community);
+
+	// SNMPv2-Trap-PDU (0xa7)
+	packet_trap[packet_index++] = SNMPV2_TRAP_PDU;
+	packet_trap[packet_index] = 0xff;
+	pb_pdu = packet_index++;
+
+	// request-id, error-status, error-index all zero
+	packet_trap[packet_index++] = 0x02; packet_trap[packet_index++] = 0x01; packet_trap[packet_index++] = 0x00;
+	packet_trap[packet_index++] = 0x02; packet_trap[packet_index++] = 0x01; packet_trap[packet_index++] = 0x00;
+	packet_trap[packet_index++] = 0x02; packet_trap[packet_index++] = 0x01; packet_trap[packet_index++] = 0x00;
+
+	// VarBindings SEQUENCE OF
+	packet_trap[packet_index++] = 0x30;
+	packet_trap[packet_index] = 0xff;
+	pb_varbinds = packet_index++;
+	int32_t vb_start = packet_index;
+
+	// VarBind 1: sysUpTime.0 = TimeTicks
+	currentUptime(&uptime, &uptime_len);
+	uint32_t uptime_be = HTONL(uptime);
+	packet_trap[packet_index++] = 0x30;
+	packet_trap[packet_index++] = 2 + (uint8_t)sizeof(oid_sysUpTime) + 2 + 4;
+	packet_trap[packet_index++] = 0x06; packet_trap[packet_index++] = (uint8_t)sizeof(oid_sysUpTime);
+	memcpy(&packet_trap[packet_index], oid_sysUpTime, sizeof(oid_sysUpTime)); packet_index += sizeof(oid_sysUpTime);
+	packet_trap[packet_index++] = SNMPDTYPE_TIME_TICKS; packet_trap[packet_index++] = 0x04;
+	memcpy(&packet_trap[packet_index], &uptime_be, 4); packet_index += 4;
+
+	// VarBind 2: snmpTrapOID.0 = OID
+	packet_trap[packet_index++] = 0x30;
+	packet_trap[packet_index++] = 2 + (uint8_t)sizeof(oid_snmpTrapOID) + 2 + trap_oid_len;
+	packet_trap[packet_index++] = 0x06; packet_trap[packet_index++] = (uint8_t)sizeof(oid_snmpTrapOID);
+	memcpy(&packet_trap[packet_index], oid_snmpTrapOID, sizeof(oid_snmpTrapOID)); packet_index += sizeof(oid_snmpTrapOID);
+	packet_trap[packet_index++] = 0x06; packet_trap[packet_index++] = trap_oid_len;
+	memcpy(&packet_trap[packet_index], trap_oid, trap_oid_len); packet_index += trap_oid_len;
+
+	// Additional VarBinds from caller
+	va_start(ap, va_count);
+	for (i = 0; i < va_count; i++)
+	{
+		dataEntryType *vb = va_arg(ap, dataEntryType*);
+		makeTrapVariableBindings(vb, &packet_trap[packet_index], &length_buff);
+		packet_index += length_buff;
+	}
+	va_end(ap);
+
+	// Fill deferred lengths
+	packet_trap[pb_varbinds] = (uint8_t)(packet_index - vb_start);
+	packet_trap[pb_pdu]      = (uint8_t)(packet_index - (pb_pdu + 1));
+	packet_trap[pb_outer]    = (uint8_t)(packet_index - 2);
+
+	socket(SOCK_SNMP_TRAP, Sn_MR_UDP, PORT_SNMP_TRAP, 0);
+	sendto(SOCK_SNMP_TRAP, packet_trap, packet_index, managerIP, PORT_SNMP_TRAP);
+	close(SOCK_SNMP_TRAP);
+	return 0;
+}
