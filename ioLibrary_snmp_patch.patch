+static int32_t parseGetBulk(int32_t nonRepeaters, int32_t maxRepetitions)
+{
+	tlvStructType seqof;
+	int32_t size = 0, seglen, respLoc;
+	int32_t i, rep;
+
+	int32_t  cur_ids[MAX_BULK_VARS];
+	uint8_t  orig_oids[MAX_BULK_VARS][MAX_OID];
+	uint8_t  orig_oid_lens[MAX_BULK_VARS];
+	uint8_t  eom[MAX_BULK_VARS];
+	int32_t  var_count = 0;
+
+	parseTLV(request_msg.buffer, request_msg.index, &seqof);
+	if (request_msg.buffer[seqof.start] != SNMPDTYPE_SEQUENCE_OF) return -1;
+
+	seglen = seqof.vstart - seqof.start;
+	respLoc = response_msg.index;
+	COPY_SEGMENT(seqof);
+
+	// Collect all requested VarBind OIDs and compute starting MIB indices
+	while (request_msg.index < request_msg.len && var_count < MAX_BULK_VARS)
+	{
+		tlvStructType seq, name;
+
+		parseTLV(request_msg.buffer, request_msg.index, &seq);
+		if (request_msg.buffer[seq.start] != SNMPDTYPE_SEQUENCE) break;
+
+		request_msg.index = seq.vstart;
+		parseTLV(request_msg.buffer, request_msg.index, &name);
+		if (request_msg.buffer[name.start] != SNMPDTYPE_OBJ_ID) break;
+
+		orig_oid_lens[var_count] = (uint8_t)name.len;
+		memcpy(orig_oids[var_count], &request_msg.buffer[name.vstart], name.len);
+
+		int32_t id = findNextEntry(&request_msg.buffer[name.vstart], name.len);
+		cur_ids[var_count] = id; // findNextEntry() already yields the next entry
+		eom[var_count] = (cur_ids[var_count] >= maxData) ? 1 : 0;
+
+		request_msg.index = seq.nstart;
+		var_count++;
+	}
+
+	if (maxRepetitions < 0) maxRepetitions = 0;
+	if (maxRepetitions > maxData) maxRepetitions = maxData;
+
+	// Non-repeaters: single GET-NEXT each
+	for (i = 0; i < nonRepeaters && i < var_count; i++)
+	{
+		int32_t written = writeBulkVarBind(eom[i] ? -1 : cur_ids[i],
+		                                   orig_oids[i], orig_oid_lens[i]);
+		if (written < 0) goto done;
+		size += written;
+	}
+
+	// Repeaters: up to maxRepetitions iterations over remaining vars
+	for (rep = 0; rep < maxRepetitions; rep++)
+	{
+		int32_t all_eom = 1;
+		for (i = nonRepeaters; i < var_count; i++)
+			if (!eom[i]) { all_eom = 0; break; }
+		if (all_eom) break;
+
+		for (i = nonRepeaters; i < var_count; i++)
+		{
+			int32_t written = writeBulkVarBind(eom[i] ? -1 : cur_ids[i],
+			                                   orig_oids[i], orig_oid_lens[i]);
+			if (written < 0) goto done;
+			size += written;
+
+			if (!eom[i])
+			{
+				cur_ids[i]++;
+				if (cur_ids[i] >= maxData) eom[i] = 1;
+			}
+		}
+	}
+
+done:
+	insertRespLen(seqof.start, respLoc, size);
+	return size + seglen;
+}
