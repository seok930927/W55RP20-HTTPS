+/* GET-NEXT lookup: return the index of the first snmpData[] entry whose OID is
+   lexicographically greater than the requested OID. snmpData[] is kept in
+   ascending OID order, so a linear scan suffices. Returns maxData when the
+   requested OID is at or past the end of the MIB (end-of-MIB-view). */
+int32_t findNextEntry(uint8_t *oid, int32_t len)
+{
+	int32_t i;
+
+	for (i = 0 ; i < maxData ; i++)
+	{
+		if (oidCompare(snmpData[i].oid, snmpData[i].oidlen, oid, len) > 0)
+			return i;
+	}
+
+	return maxData;
+}
